{
  "permissions": {
    "allow": [
      "Bash(gh api -X POST repos/Rammanobi/simulate_gold/actions/workflows/market-hours.yml/dispatches:*)",
      "Bash(gh api -X POST repos/Rammanobi/simulate_gold/actions/workflows/watchdog.yml/dispatches:*)",
      "Bash(gh api -X POST repos/Rammanobi/simulate_gold/actions/workflows/reminders.yml/dispatches:*)",
      "Bash(gh api repos/Rammanobi/simulate_gold/actions/runs:*)",
      "Bash(gh api \"repos/Rammanobi/simulate_gold/actions/runs?:*)",
      "Bash(gh api \"repos/Rammanobi/simulate_gold/actions/workflows/market-hours.yml/runs?:*)",
      "Bash(git pull --rebase --autostash:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(python tools/send_report.py:*)",
      "Bash(python tools/inbox.py:*)",
      "Bash(python tools/dashboard.py:*)",
      "Bash(python tools/report_retry.py:*)",
      "Bash(cat config/inbox_url.txt)",
      "Bash(cat config/dashboard_url.txt)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Gg][Mm][Aa][Ii][Ll].*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I .claude/hooks/gmail_guard.py"
          }
        ]
      }
    ]
  }
}
